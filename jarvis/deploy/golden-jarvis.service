[Unit]
Description=Golden Jarvis Backend
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=jarvis
Group=jarvis
WorkingDirectory=/opt/golden-jarvis/backend
EnvironmentFile=/opt/golden-jarvis/.env
ExecStart=/opt/golden-jarvis/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8780 --proxy-headers --forwarded-allow-ips 127.0.0.1
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/golden-jarvis/data /opt/golden-jarvis/uploads /opt/golden-jarvis/logs /opt/golden-jarvis/backups

[Install]
WantedBy=multi-user.target
