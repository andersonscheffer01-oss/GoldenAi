{$JARVIS_DOMAIN} {
    encode zstd gzip
    reverse_proxy backend:8780

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "no-referrer"
        -Server
    }

    @private path /api/* /uploads/*
    header @private Cache-Control "no-store, private"

    log {
        output file /data/access.log {
            roll_size 10MiB
            roll_keep 10
            roll_keep_for 168h
        }
        format json
    }
}
