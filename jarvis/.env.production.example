JARVIS_ENVIRONMENT=production
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8780
JARVIS_DATABASE_URL=postgresql+psycopg://jarvis:CHANGE_DATABASE_PASSWORD@postgres:5432/golden_jarvis
JARVIS_SECRET_KEY=CHANGE_TO_AT_LEAST_32_RANDOM_CHARACTERS
JARVIS_ACCESS_TOKEN_EXPIRE_MINUTES=60
JARVIS_ALLOWED_ORIGINS=https://jarvis.seudominio.com.br
JARVIS_TRUSTED_HOSTS=jarvis.seudominio.com.br
JARVIS_OLLAMA_BASE_URL=http://host.docker.internal:11434
JARVIS_OLLAMA_MODEL=qwen2.5vl:7b
JARVIS_UPLOAD_MAX_SIZE_MB=10
JARVIS_ALERTS_ENABLED=true
JARVIS_PUSH_ENABLED=true
JARVIS_SERVER_PUBLIC_URL=https://jarvis.seudominio.com.br
JARVIS_LOG_LEVEL=INFO
JARVIS_LOG_MAX_BYTES=10485760
JARVIS_LOG_BACKUP_COUNT=10
JARVIS_DOMAIN=jarvis.seudominio.com.br
POSTGRES_DB=golden_jarvis
POSTGRES_USER=jarvis
POSTGRES_PASSWORD=CHANGE_DATABASE_PASSWORD
